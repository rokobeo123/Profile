    "db:setup": "docker-compose up -d && pnpm exec prisma migrate dev && pnpm exec prisma db seed"
  },
  "dependencies": {
    "framer-motion": "latest",
    "next": "16.2.10",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.4.3",
    "zustand": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
